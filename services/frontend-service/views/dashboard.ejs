<section class="pt-28 pb-20">
  <div class="mx-auto max-w-7xl px-6">

    <!-- Page header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold text-kube-heading md:text-3xl">
          Welcome back <span class="text-kube-primary"><%= currentUser.username %></span>
        </h1>
      </div>
      <div class="flex items-center gap-3">
        <a href="/courses" class="rounded-lg bg-kube-primary px-4 py-2 text-sm font-medium text-kube-bg transition-colors hover:bg-kube-primary/90">Browse courses</a>
        <a href="/logout" class="inline-flex items-center gap-2 rounded-lg border border-kube-border px-4 py-2 text-sm text-kube-muted transition-colors hover:border-red-500/30 hover:bg-red-500/10 hover:text-red-400">
          <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          Logout
        </a>
      </div>
    </div>

    <!-- Stats cards (real data) -->
    <div id="stats" class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-kube-border bg-kube-surface p-5">
        <p class="text-sm text-kube-muted">Courses Enrolled</p>
        <p id="stat-enrolled" class="mt-3 text-3xl font-bold text-kube-heading">—</p>
      </div>
      <div class="rounded-xl border border-kube-border bg-kube-surface p-5">
        <p class="text-sm text-kube-muted">Lessons Completed</p>
        <p id="stat-lessons" class="mt-3 text-3xl font-bold text-kube-heading">—</p>
      </div>
      <div class="rounded-xl border border-kube-border bg-kube-surface p-5">
        <p class="text-sm text-kube-muted">Average Progress</p>
        <p id="stat-average" class="mt-3 text-3xl font-bold text-kube-heading">—</p>
      </div>
      <div class="rounded-xl border border-kube-border bg-kube-surface p-5">
        <p class="text-sm text-kube-muted">Available Courses</p>
        <p id="stat-available" class="mt-3 text-3xl font-bold text-kube-heading">—</p>
      </div>
    </div>

    <!-- My Courses -->
    <div class="mt-10">
      <h2 class="text-lg font-semibold text-kube-heading">My Courses</h2>
      <div id="my-courses" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <p class="col-span-full text-sm text-kube-muted">Loading...</p>
      </div>
    </div>

    <!-- Admin section (only visible to admins) -->
    <% if (currentUser && String(currentUser.role).toLowerCase() === 'admin') { %>
      <div class="mt-10">
        <h2 class="text-lg font-semibold text-kube-heading">Admin Panel</h2>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a href="/admin/courses" class="rounded-lg border border-kube-border px-4 py-2 text-sm text-kube-muted transition-colors hover:border-kube-primary/50 hover:text-kube-heading">Manage courses</a>
          <span class="rounded bg-kube-primary/10 px-2 py-0.5 text-xs font-medium text-kube-primary">Admin</span>
        </div>
        <div class="mt-4 rounded-xl border border-kube-border bg-kube-surface">
          <div class="border-b border-kube-border px-6 py-4">
            <p class="text-sm font-medium text-kube-heading">Registered Users</p>
          </div>
          <div class="p-6">
            <div id="admin-users-table">
              <p class="text-sm text-kube-muted">Loading users...</p>
            </div>
          </div>
        </div>
      </div>

      <script>
        (async function () {
          function esc(value) {
            return String(value == null ? "" : value)
              .replace(/&/g, "&amp;")
              .replace(/</g, "&lt;")
              .replace(/>/g, "&gt;")
              .replace(/"/g, "&quot;")
              .replace(/'/g, "&#39;");
          }

          try {
            const response = await fetch('/api/users');
            const result = await response.json();
            const users = result.data;
            const container = document.getElementById('admin-users-table');

            if (!users || users.length === 0) {
              container.innerHTML = '<p class="text-sm text-kube-muted">No users found.</p>';
              return;
            }

            let html = '<div class="overflow-x-auto">';
            html += '<table class="w-full text-left text-sm">';
            html += '<thead><tr class="border-b border-kube-border">';
            html += '<th class="pb-3 pr-6 font-medium text-kube-muted">ID</th>';
            html += '<th class="pb-3 pr-6 font-medium text-kube-muted">Username</th>';
            html += '<th class="pb-3 pr-6 font-medium text-kube-muted">Role</th>';
            html += '</tr></thead>';
            html += '<tbody>';

            users.forEach(function (user) {
              html += '<tr class="border-b border-kube-border/50 last:border-0">';
              html += '<td class="py-3 pr-6 font-mono text-xs text-kube-muted">' + user.id + '</td>';
              html += '<td class="py-3 pr-6 text-kube-heading">' + esc(user.username) + '</td>';
              html += '<td class="py-3 pr-6 text-kube-muted">' + (user.role || 'user') + '</td>';
              html += '</tr>';
            });

            html += '</tbody></table></div>';
            html += '<p class="mt-3 text-xs text-kube-muted">Source: ' + result.source + '</p>';

            container.innerHTML = html;
          } catch (err) {
            document.getElementById('admin-users-table').innerHTML =
              '<p class="text-sm text-red-400">Failed to load users.</p>';
          }
        })();
      </script>
    <% } %>

  </div>
</section>

<script>
  (async function () {
    function esc(value) {
      return String(value == null ? "" : value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    const levelColors = {
      beginner: 'text-green-400',
      intermediate: 'text-yellow-400',
      advanced: 'text-red-400',
      expert: 'text-purple-400',
    };
    const levelBadges = {
      beginner: 'bg-green-500/10',
      intermediate: 'bg-yellow-500/10',
      advanced: 'bg-red-500/10',
      expert: 'bg-purple-500/10',
    };

    let progressData = [];
    let allCourses = [];

    try {
      const progressResponse = await fetch('/api/progress');
      if (progressResponse.ok) {
        progressData = (await progressResponse.json()).data || [];
      }
    } catch (err) {
      console.error('progress error', err);
    }

    try {
      const coursesResponse = await fetch('/api/courses');
      if (coursesResponse.ok) {
        allCourses = (await coursesResponse.json()).courses || [];
      }
    } catch (err) {
      console.error('courses error', err);
    }

    var completedLessons = progressData.reduce(function (sum, p) { return sum + p.completedLessons; }, 0);
    var totalLessons = progressData.reduce(function (sum, p) { return sum + p.totalLessons; }, 0);
    var avg = progressData.length
      ? Math.round(progressData.reduce(function (sum, p) { return sum + p.progress; }, 0) / progressData.length)
      : 0;

    // Prochaine leçon incomplète par cours inscrit
    var nextLessons = {};
    if (progressData.length > 0) {
      await Promise.all(progressData.map(async function (p) {
        try {
          const [detailRes, progRes] = await Promise.all([
            fetch('/api/courses/' + p.courseId),
            fetch('/api/progress/courses/' + p.courseId),
          ]);
          if (!detailRes.ok || !progRes.ok) return;
          const detail = await detailRes.json();
          const byCourse = await progRes.json();
          if (!byCourse.enrolled || !detail.lessons || !detail.lessons.length) return;
          var done = new Set((byCourse.completedLessonIds || []).map(String));
          var ordered = detail.lessons.slice().sort(function (a, b) { return a.order_index - b.order_index; });
          var next = ordered.find(function (l) { return !done.has(String(l.id)); });
          if (next) {
            nextLessons[String(p.courseId)] =
              '/courses/' + esc(detail.slug) + '/lessons/' + esc(next.slug);
          }
        } catch (e) { /* leçon suivante indisponible */ }
      }));
    }

    document.getElementById('stat-enrolled').textContent = progressData.length;
    document.getElementById('stat-lessons').textContent = completedLessons;
    document.getElementById('stat-average').textContent = avg + '%';
    document.getElementById('stat-available').textContent = allCourses.length;

    var myCourses = document.getElementById('my-courses');
    if (progressData.length === 0) {
      myCourses.innerHTML =
        '<p class="col-span-full text-sm text-kube-muted">No enrollments yet. ' +
        '<a href="/courses" class="text-kube-primary underline">Browse courses</a> to get started.</p>';
      return;
    }

    myCourses.innerHTML = progressData.map(function (p) {
      var badge = (levelBadges[p.level] || levelBadges.beginner);
      var color = (levelColors[p.level] || levelColors.beginner);
      var nextUrl = nextLessons[String(p.courseId)];
      return (
        '<div class="rounded-xl border border-kube-border bg-kube-surface p-5">' +
        '<div class="flex items-center justify-between">' +
        '<span class="rounded-full ' + badge + ' px-3 py-0.5 text-xs font-medium ' + color + '">' +
        p.level.charAt(0).toUpperCase() + p.level.slice(1) + '</span>' +
        '<span class="text-xs text-kube-muted">' + p.progress + '%</span></div>' +
        '<a href="/courses/' + esc(p.slug) + '">' +
        '<h3 class="mt-3 text-sm font-semibold text-kube-heading hover:text-kube-primary">' + esc(p.title) + '</h3></a>' +
        '<div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-kube-card">' +
        '<div class="h-full rounded-full bg-kube-primary" style="width:' + p.progress + '%"></div></div>' +
        '<p class="mt-3 text-xs text-kube-muted">' + p.completedLessons + ' / ' + p.totalLessons + ' lessons completed</p>' +
        '<a href="' + (nextUrl || '/courses/' + esc(p.slug)) + '" class="mt-4 inline-block text-sm font-medium text-kube-primary hover:underline">' +
        (nextUrl ? 'Continue →' : 'Completed ✓') + '</a>' +
        '</div>'
      );
    }).join('');
  })();
</script>